{
  "name": "pagelabs",
  "version": "0.1.0",
  "private": true,
  "description": "Clean, privacy-first suite of 30+ PDF tools: merge, compress, convert, OCR and more. Files shredded after processing.",
  "license": "MIT",
  "author": "tanbopp",
  "homepage": "https://pagelabs.tanbopp.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanbopp/pagelabs-pdf-tools.git"
  },
  "bugs": {
    "url": "https://github.com/tanbopp/pagelabs-pdf-tools/issues"
  },
  "keywords": [
    "pdf-tools",
    "pdf-processing",
    "pdf-converter",
    "pdf-compressor",
    "ocr",
    "privacy-first",
    "open-source",
    "nextjs",
    "hono",
    "typescript",
    "python",
    "tailwindcss",
    "monorepo",
    "pnpm",
    "docker",
    "bullmq",
    "ghostscript",
    "pikepdf"
  ],
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "build:vercel": "pnpm --filter shared build && pnpm --filter web build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test"
  },
  "devDependencies": {
    "next": "16.4.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
