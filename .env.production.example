# ==============================================================================
# PageLabs Production Environment Variables (.env.production.example)
# ==============================================================================

# Application Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. API Gateway Configuration
# ------------------------------------------------------------------------------
API_PORT=3001
API_BASE_URL=https://api.pagelabs.app

# ------------------------------------------------------------------------------
# 2. Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.pagelabs.app

# ------------------------------------------------------------------------------
# 3. Database (Managed PostgreSQL / RDS / Supabase)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://pagelabs_user:SECURE_STRONG_PASSWORD_HERE@pg-cluster.internal:5432/pagelabs?sslmode=require

# ------------------------------------------------------------------------------
# 4. Message Queue & Cache (Managed Redis / Upstash / AWS ElastiCache)
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:SECURE_REDIS_PASSWORD_HERE@redis-cluster.internal:6379

# ------------------------------------------------------------------------------
# 5. Object Storage (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET=pagelabs-production-storage
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 6. Operational Limits & Privacy Hardening
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_JOB=20
JOB_TTL_HOURS=2
JOB_TIMEOUT_SECONDS=300

# Strict anonymous rate limiting (10 jobs / hour per IP)
RATE_LIMIT_ANON=10
RATE_LIMIT_AUTH=100

